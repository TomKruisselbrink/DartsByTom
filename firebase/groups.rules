// Darts by Tom — Firestore-regels voor de groepssync (fase 1, v245)
// Dit is GEEN volledig regelbestand: het is het blok voor `groups`, bedoeld om in de Firebase-console
// (Firestore → Regels) binnen `match /databases/{database}/documents { … }` te zetten.
// Lees eerst firebase/README.md: zolang er een catch-all `match /{document=**}` met `allow write: if true`
// bestaat, heeft dit blok geen effect (Firestore staat toe zodra één regel toestaat).
//
// Wat het doet: de groep blijft open voor wie de code heeft (zoals nu, dus geen account nodig),
// maar alleen met geldige inhoud: spelersnamen zonder < > " ` en een speler met de juiste veldtypes.

    function dbtValidName(n) {
      return n is string && n.size() > 0 && n.size() <= 60 && !n.matches('.*[<>"`].*');
    }
    function dbtOptType(d, key, t) {
      return !(key in d) || (t == 'number' && d[key] is number) || (t == 'list' && d[key] is list)
          || (t == 'map' && d[key] is map) || (t == 'string' && d[key] is string);
    }
    function dbtValidPlayer(d) {
      return dbtOptType(d, 'games', 'number') && dbtOptType(d, 'wins', 'number')
          && dbtOptType(d, 'totalDarts', 'number') && dbtOptType(d, 'totalScore', 'number')
          && dbtOptType(d, 'gameHistory', 'list') && dbtOptType(d, 'deleted', 'list')
          && dbtOptType(d, 'doubleStats', 'map')
          && (!('nickname' in d) || (d.nickname is string && d.nickname.size() <= 40 && !d.nickname.matches('.*[<>"`].*')));
    }

    match /groups/{code} {
      allow read: if true;
      allow create, update: if code.size() <= 40
          && request.resource.data.keys().hasOnly(['hidden'])
          && (!('hidden' in request.resource.data) || (request.resource.data.hidden is list && request.resource.data.hidden.size() <= 300));
      allow delete: if false;

      match /players/{name} {
        allow read: if true;
        allow delete: if dbtValidName(name);
        allow create, update: if dbtValidName(name) && dbtValidPlayer(request.resource.data);
      }
    }
